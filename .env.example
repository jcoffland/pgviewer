# Copy to .env.local and fill in.
# Get a free Cesium ion token at https://cesium.com/ion/tokens.
VITE_CESIUM_ION_TOKEN=

# URL of the deployed share-storage worker (see worker/README.md).
# Without this set, the share button reports an error instead of
# uploading. Comment out or leave empty to disable sharing.
VITE_STORAGE_URL=
