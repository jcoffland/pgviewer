// Reset and global layout

*, *::before, *::after
  box-sizing border-box

html, body, #app
  height 100%
  margin 0

body
  font-family system-ui, -apple-system, sans-serif
  font-size 14px
  color #eee
  background #1a1a1a
  overflow hidden

button
  font inherit
  color inherit
  background #2a2a2a
  border 1px solid #444
  border-radius 3px
  padding 4px 10px
  cursor pointer

  &:hover
    background #333

  &.active
    background #2a4a6a
    border-color #4a6a8a
